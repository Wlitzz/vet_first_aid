<%= form_with model: [:admin, @procedure, video], local: true, class: "space-y-5" do |f| %>
  <% if video.errors.any? %>
    <div class="bg-red-50 border border-red-300 text-red-700 rounded-lg px-4 py-3 text-sm">
      <p class="font-semibold mb-1"><%= video.errors.count %> error(s):</p>
      <ul class="list-disc list-inside space-y-1">
        <% video.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :title, "Video Title", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :title,
      class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500",
      placeholder: "e.g. How to perform Heimlich for dogs" %>
  </div>

  <div>
    <%= f.label :url, "YouTube URL", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <p class="text-xs text-gray-500 mb-1">Paste a YouTube watch URL (e.g. https://www.youtube.com/watch?v=...) or youtu.be link.</p>
    <%= f.url_field :url,
      class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500",
      placeholder: "https://www.youtube.com/watch?v=..." %>
  </div>

  <div>
    <%= f.label :description, "Description (optional)", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_area :description, rows: 2,
      class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
  </div>

  <%# XOR attachment: procedure-level OR a specific step %>
  <div>
    <p class="text-sm font-medium text-gray-700 mb-2">Attach this video to:</p>
    <div class="space-y-3" data-controller="video-attach">
      <label class="flex items-center gap-3 cursor-pointer">
        <input type="radio" name="attach_to" value="procedure" class="text-blue-600"
          <%= video.step_id.blank? ? "checked" : "" %>
          data-action="change->video-attach#toggle">
        <span class="text-sm text-gray-700">The whole procedure (<strong><%= @procedure.name %></strong>)</span>
      </label>

      <label class="flex items-center gap-3 cursor-pointer">
        <input type="radio" name="attach_to" value="step" class="text-blue-600"
          <%= video.step_id.present? ? "checked" : "" %>
          data-action="change->video-attach#toggle">
        <span class="text-sm text-gray-700">A specific step</span>
      </label>

      <div id="step-selector" class="pl-7 <%= video.step_id.blank? ? 'hidden' : '' %>">
        <% steps = @procedure.steps %>
        <% if steps.any? %>
          <select name="instructional_video[step_id]" id="step_select"
            class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
            <option value="">Select a step</option>
            <% steps.each do |step| %>
              <option value="<%= step.id %>" <%= video.step_id == step.id ? "selected" : "" %>>
                Step <%= step.position %>: <%= step.instruction.truncate(60) %>
              </option>
            <% end %>
          </select>
        <% else %>
          <p class="text-xs text-gray-500">No steps exist yet for this procedure. Add steps first.</p>
        <% end %>
      </div>
    </div>
  </div>

  <div class="flex gap-3 pt-2">
    <%= f.submit class: "bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-2 rounded-lg text-sm cursor-pointer transition-colors" %>
    <%= link_to "Cancel", admin_first_aid_procedure_path(@procedure), class: "text-gray-500 hover:text-gray-700 text-sm py-2" %>
  </div>
<% end %>

<script>
  document.querySelectorAll('input[name="attach_to"]').forEach(function(radio) {
    radio.addEventListener('change', function() {
      var stepSelector = document.getElementById('step-selector');
        if (this.value === 'step') {
          stepSelector.classList.remove('hidden');
        } else {
          stepSelector.classList.add('hidden');
          document.getElementById('step_select') && (document.getElementById('step_select').value = '');
        }
      });
  });
</script>
