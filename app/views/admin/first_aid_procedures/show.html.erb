<% content_for :title, "Admin – #{@procedure.name}" %>

<div class="max-w-3xl mx-auto">
  <div class="flex justify-between items-start mb-6">
    <div>
      <h1 class="text-2xl font-extrabold text-gray-900"><%= @procedure.name %></h1>
      <p class="text-sm text-gray-500 capitalize mt-1"><%= @procedure.species %> &middot; <%= @procedure.severity_label %></p>
    </div>
    <div class="flex gap-3">
      <%= link_to "Edit", edit_admin_first_aid_procedure_path(@procedure),
        class: "border border-gray-300 text-gray-700 hover:bg-gray-100 font-medium px-4 py-2 rounded-lg text-sm transition-colors" %>
      <%= link_to "Delete", admin_first_aid_procedure_path(@procedure),
        data: { turbo_method: :delete, turbo_confirm: "Delete this procedure and all its steps?" },
        class: "bg-red-600 hover:bg-red-700 text-white font-medium px-4 py-2 rounded-lg text-sm transition-colors" %>
    </div>
  </div>

  <% if notice %>
    <div class="bg-green-100 border border-green-300 text-green-800 rounded-lg px-4 py-3 mb-6 text-sm"><%= notice %></div>
  <% end %>

  <div class="bg-white border border-gray-200 rounded-xl p-5 mb-6">
    <p class="text-gray-700 text-sm"><%= @procedure.description %></p>
    <p class="text-xs text-gray-400 mt-3">Keywords: <%= @procedure.symptom_keywords %></p>
  </div>

  <% videos = @procedure.instructional_videos.to_a + @procedure.steps.flat_map(&:instructional_videos) %>
  <div class="bg-white border border-gray-200 rounded-xl p-5 mb-6">
    <div class="flex justify-between items-center mb-3">
      <h2 class="text-lg font-bold text-gray-900">Videos</h2>
      <%= link_to "Add Video", new_admin_first_aid_procedure_instructional_video_path(@procedure),
        class: "text-sm text-blue-600 hover:text-blue-800 font-semibold" %>
    </div>

    <% if videos.any? %>
      <div class="space-y-3">
        <% videos.each do |video| %>
          <div class="flex justify-between gap-4 items-start border-t border-gray-100 pt-3">
            <div>
              <p class="text-sm font-semibold text-gray-800"><%= video.title %></p>
              <p class="text-xs text-gray-500">
                Attached to
                <% if video.step %>
                  Step <%= video.step.position %>
                <% else %>
                  whole procedure
                <% end %>
              </p>
            </div>
            <div class="shrink-0 flex gap-3 text-sm">
              <%= link_to "Edit", edit_admin_first_aid_procedure_instructional_video_path(@procedure, video), class: "text-gray-600 hover:underline" %>
              <%= link_to "Delete", admin_first_aid_procedure_instructional_video_path(@procedure, video),
                data: { turbo_method: :delete, turbo_confirm: "Delete this video?" },
                class: "text-red-600 hover:underline" %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-gray-500">No videos have been added yet.</p>
    <% end %>
  </div>

  <div class="flex gap-3 flex-wrap">
    <%= link_to "Manage Steps (#{@procedure.steps.count})", admin_first_aid_procedure_steps_path(@procedure),
      class: "bg-blue-600 hover:bg-blue-700 text-white font-semibold px-5 py-2 rounded-lg text-sm transition-colors" %>
    <%= link_to "← All Procedures", admin_first_aid_procedures_path, class: "text-sm text-gray-500 hover:text-gray-700 py-2" %>
  </div>
</div>
