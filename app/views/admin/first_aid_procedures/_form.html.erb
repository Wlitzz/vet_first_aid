<%= form_with model: [:admin, procedure], local: true, class: "space-y-5" do |f| %>
  <% if procedure.errors.any? %>
    <div class="bg-red-50 border border-red-300 text-red-700 rounded-lg px-4 py-3 text-sm">
      <p class="font-semibold mb-1"><%= procedure.errors.count %> error(s) prevented saving:</p>
      <ul class="list-disc list-inside space-y-1">
        <% procedure.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, "Procedure Name", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :name, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500", placeholder: "e.g. Dog Choking" %>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <%= f.label :species, "Species", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.select :species, [["Dog", "dog"], ["Cat", "cat"], ["Rabbit", "rabbit"], ["Hamster", "hamster"]],
        { include_blank: "Select a species" },
        class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
    </div>
    <div>
      <%= f.label :severity, "Severity", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.select :severity, [["Immediate Action Required", "immediate"], ["Consult Vet Soon", "consult_vet_soon"]],
        { include_blank: "Select a severity" },
        class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
    </div>
  </div>

  <div>
    <%= f.label :description, "Description", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_area :description, rows: 4,
      class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500",
      placeholder: "Describe what this procedure is for..." %>
  </div>

  <div>
    <%= f.label :symptom_keywords, "Symptom Keywords", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <p class="text-xs text-gray-500 mb-1">Comma-separated keywords used for triage search. e.g. choking, coughing, blue gums</p>
    <%= f.text_area :symptom_keywords, rows: 2,
      class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500",
      placeholder: "choking, coughing, difficulty breathing" %>
  </div>

  <div class="flex gap-3 pt-2">
    <%= f.submit class: "bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-2 rounded-lg text-sm cursor-pointer transition-colors" %>
    <%= link_to "Cancel", admin_first_aid_procedures_path, class: "text-gray-500 hover:text-gray-700 text-sm py-2" %>
  </div>
<% end %>
