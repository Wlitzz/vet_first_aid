<% content_for :title, "Admin – Procedures" %>

<div class="max-w-5xl mx-auto">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-extrabold text-gray-900">First Aid Procedures</h1>
    <%= link_to "＋ New Procedure", new_admin_first_aid_procedure_path,
      class: "bg-blue-600 hover:bg-blue-700 text-white font-semibold px-5 py-2 rounded-lg text-sm transition-colors" %>
  </div>

  <% if notice %>
    <div class="bg-green-100 border border-green-300 text-green-800 rounded-lg px-4 py-3 mb-6 text-sm"><%= notice %></div>
  <% end %>

  <% if @procedures.any? %>
    <div class="overflow-x-auto rounded-xl border border-gray-200 shadow-sm">
      <table class="min-w-full text-sm bg-white">
        <thead class="bg-gray-50 text-gray-600 uppercase text-xs tracking-wide">
          <tr>
            <th class="px-4 py-3 text-left">Name</th>
            <th class="px-4 py-3 text-left">Species</th>
            <th class="px-4 py-3 text-left">Severity</th>
            <th class="px-4 py-3 text-center">Steps</th>
            <th class="px-4 py-3 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @procedures.each do |procedure| %>
            <tr class="hover:bg-gray-50">
              <td class="px-4 py-3 font-medium text-gray-900"><%= procedure.name %></td>
              <td class="px-4 py-3 capitalize text-gray-600"><%= procedure.species %></td>
              <td class="px-4 py-3">
                <span class="px-2 py-0.5 rounded-full text-xs font-bold
                  <%= procedure.severity == 'immediate' ? 'bg-red-100 text-red-700' : 'bg-yellow-100 text-yellow-700' %>">
                  <%= procedure.severity_label %>
                </span>
              </td>
              <td class="px-4 py-3 text-center text-gray-600"><%= procedure.steps.count %></td>
              <td class="px-4 py-3 text-right space-x-3">
                <%= link_to "Steps", admin_first_aid_procedure_steps_path(procedure), class: "text-blue-600 hover:underline" %>
                <%= link_to "Edit", edit_admin_first_aid_procedure_path(procedure), class: "text-gray-600 hover:underline" %>
                <%= link_to "Delete", admin_first_aid_procedure_path(procedure),
                  data: { turbo_method: :delete, turbo_confirm: "Delete '#{procedure.name}' and all its steps?" },
                  class: "text-red-600 hover:underline" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="text-gray-500 text-center py-10">No procedures yet. <%= link_to "Add one", new_admin_first_aid_procedure_path, class: "text-blue-600 hover:underline" %>.</p>
  <% end %>
</div>
