<% content_for :title, "Admin – Steps for #{@procedure.name}" %>

<div class="max-w-3xl mx-auto">
  <div class="flex justify-between items-center mb-6">
    <div>
      <h1 class="text-2xl font-extrabold text-gray-900">Steps</h1>
      <p class="text-sm text-gray-500 mt-1">For: <strong><%= @procedure.name %></strong></p>
    </div>
    <%= link_to "＋ New Step", new_admin_first_aid_procedure_step_path(@procedure),
      class: "bg-blue-600 hover:bg-blue-700 text-white font-semibold px-5 py-2 rounded-lg text-sm transition-colors" %>
  </div>

  <% if notice %>
    <div class="bg-green-100 border border-green-300 text-green-800 rounded-lg px-4 py-3 mb-6 text-sm"><%= notice %></div>
  <% end %>

  <% if @steps.any? %>
    <div class="space-y-3">
      <% @steps.each do |step| %>
        <div class="bg-white border border-gray-200 rounded-xl p-4 flex gap-4 items-start shadow-sm">
          <span class="shrink-0 w-8 h-8 bg-blue-100 text-blue-700 rounded-full flex items-center justify-center text-sm font-bold"><%= step.position %></span>
          <div class="flex-1 min-w-0">
            <p class="text-sm text-gray-800 line-clamp-2"><%= step.instruction %></p>
            <% if step.checklist.present? %>
              <p class="text-xs text-gray-400 mt-1">Checklist: <%= step.checklist.truncate(60) %></p>
            <% end %>
          </div>
          <div class="shrink-0 flex gap-3 text-sm">
            <%= link_to "Edit", edit_admin_first_aid_procedure_step_path(@procedure, step), class: "text-gray-600 hover:underline" %>
            <%= link_to "Delete", admin_first_aid_procedure_step_path(@procedure, step),
              data: { turbo_method: :delete, turbo_confirm: "Delete step #{step.position}?" },
              class: "text-red-600 hover:underline" %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-gray-500 text-center py-10">No steps yet. <%= link_to "Add one", new_admin_first_aid_procedure_step_path(@procedure), class: "text-blue-600 hover:underline" %>.</p>
  <% end %>

  <div class="mt-6">
    <%= link_to "← Back to Procedure", admin_first_aid_procedure_path(@procedure), class: "text-sm text-blue-600 hover:text-blue-800" %>
  </div>
</div>
