<%= form_with model: [:admin, @procedure, step], local: true, class: "space-y-5" do |f| %>
  <% if step.errors.any? %>
    <div class="bg-red-50 border border-red-300 text-red-700 rounded-lg px-4 py-3 text-sm">
      <p class="font-semibold mb-1"><%= step.errors.count %> error(s):</p>
      <ul class="list-disc list-inside space-y-1">
        <% step.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :position, "Step Number", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <p class="text-xs text-gray-500 mb-1">Must be a unique positive number (e.g. 1, 2, 3).</p>
    <%= f.number_field :position, min: 1,
      class: "w-32 border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
  </div>

  <div>
    <%= f.label :instruction, "Instruction", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_area :instruction, rows: 4,
      class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500",
      placeholder: "Describe what the pet owner should do..." %>
  </div>

  <div>
    <%= f.label :checklist, "What to Look For (Checklist)", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <p class="text-xs text-gray-500 mb-1">One item per line. End each line with "if unsure, contact an emergency vet clinic."</p>
    <%= f.text_area :checklist, rows: 4,
      class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500",
      placeholder: "Pet is breathing normally\nGums are pink, not blue\nIf unsure, contact an emergency vet clinic immediately" %>
  </div>

  <div class="flex gap-3 pt-2">
    <%= f.submit class: "bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-2 rounded-lg text-sm cursor-pointer transition-colors" %>
    <%= link_to "Cancel", admin_first_aid_procedure_steps_path(@procedure), class: "text-gray-500 hover:text-gray-700 text-sm py-2" %>
  </div>
<% end %>
