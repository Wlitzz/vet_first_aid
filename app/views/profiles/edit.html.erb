<div class="max-w-3xl mx-auto">

  <div class="bg-white rounded-3xl shadow-xl border border-blue-100 p-8">

    <h1 class="text-4xl font-bold text-gray-900 mb-2">
      Edit Profile
    </h1>

    <p class="text-gray-500 mb-8">
      Update your account information.
    </p>

    <%= form_with model: @account, url: "/profile", method: :patch, local: true do |form| %>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

        <div>
          <%= form.label :first_name, class: "block text-sm font-semibold text-gray-700 mb-2" %>

          <%= form.text_field :first_name,
            class: "w-full border border-gray-300 rounded-2xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
        </div>

        <div>
          <%= form.label :last_name, class: "block text-sm font-semibold text-gray-700 mb-2" %>

          <%= form.text_field :last_name,
            class: "w-full border border-gray-300 rounded-2xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
        </div>

      </div>

      <div class="mt-6">
        <%= form.label :email, class: "block text-sm font-semibold text-gray-700 mb-2" %>

        <%= form.email_field :email,
          class: "w-full border border-gray-300 rounded-2xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>

      <div class="mt-8 flex gap-4">

        <%= form.submit "Save Changes",
          class: "bg-blue-700 hover:bg-blue-800 text-white px-6 py-3 rounded-xl font-semibold cursor-pointer" %>

        <a href="/profile"
           class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-6 py-3 rounded-xl font-semibold">
          Cancel
        </a>

      </div>

    <% end %>

  </div>

</div>