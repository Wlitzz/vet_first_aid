<div class="max-w-4xl mx-auto">

  <div class="bg-white rounded-3xl shadow-xl border border-blue-100 p-10">

    <div class="mb-8">
      <h1 class="text-4xl font-bold text-gray-900">
        Add New Pet
      </h1>

      <p class="text-gray-500 mt-2">
        Register your pet profile for emergency first-aid guidance.
      </p>
    </div>

    <% if @pet.errors.any? %>

      <div class="mb-6 bg-red-100 border border-red-300 text-red-700 px-4 py-3 rounded-2xl">
        <ul class="list-disc ml-5">
          <% @pet.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>

    <% end %>

    <%= form_with model: @pet, local: true, class: "space-y-7" do |f| %>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

        <div>
          <%= f.label :name,
            class: "block text-sm font-semibold text-gray-700 mb-3" %>

          <%= f.text_field :name,
            placeholder: "Pet name",
            class: "w-full px-5 py-4 rounded-2xl border border-gray-300 focus:border-blue-500 focus:ring-2 focus:ring-blue-300 focus:outline-none transition-all text-lg" %>
        </div>

        <div>
          <%= f.label :species,
            class: "block text-sm font-semibold text-gray-700 mb-3" %>

          <%= f.select :species,
            ["Dog", "Cat", "Bird", "Rabbit", "Other"],
            {},
            class: "w-full px-5 py-4 rounded-2xl border border-gray-300 focus:border-blue-500 focus:ring-2 focus:ring-blue-300 focus:outline-none transition-all text-lg bg-white" %>
        </div>

      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

        <div>
          <%= f.label :breed,
            class: "block text-sm font-semibold text-gray-700 mb-3" %>

          <%= f.text_field :breed,
            placeholder: "Breed",
            class: "w-full px-5 py-4 rounded-2xl border border-gray-300 focus:border-blue-500 focus:ring-2 focus:ring-blue-300 focus:outline-none transition-all text-lg" %>
        </div>

        <div>
          <%= f.label :date_of_birth,
            "Date of Birth",
            class: "block text-sm font-semibold text-gray-700 mb-3" %>

          <%= f.date_field :date_of_birth,
            class: "w-full px-5 py-4 rounded-2xl border border-gray-300 focus:border-blue-500 focus:ring-2 focus:ring-blue-300 focus:outline-none transition-all text-lg" %>
        </div>

      </div>

      <div>
        <%= f.label :weight,
          class: "block text-sm font-semibold text-gray-700 mb-3" %>

        <%= f.number_field :weight,
          step: 0.1,
          placeholder: "Weight in kg",
          class: "w-full px-5 py-4 rounded-2xl border border-gray-300 focus:border-blue-500 focus:ring-2 focus:ring-blue-300 focus:outline-none transition-all text-lg" %>
      </div>

      <div>
        <%= f.label :allergies,
          class: "block text-sm font-semibold text-gray-700 mb-3" %>

        <%= f.text_area :allergies,
          rows: 3,
          placeholder: "Any allergies?",
          class: "w-full px-5 py-4 rounded-2xl border border-gray-300 focus:border-blue-500 focus:ring-2 focus:ring-blue-300 focus:outline-none transition-all text-lg" %>
      </div>

      <div>
        <%= f.label :medical_notes,
          class: "block text-sm font-semibold text-gray-700 mb-3" %>

        <%= f.text_area :medical_notes,
          rows: 4,
          placeholder: "Additional medical notes",
          class: "w-full px-5 py-4 rounded-2xl border border-gray-300 focus:border-blue-500 focus:ring-2 focus:ring-blue-300 focus:outline-none transition-all text-lg" %>
      </div>

      <div class="flex gap-4 pt-4">

        <a
          href="/profile"
          class="flex-1 text-center bg-gray-100 hover:bg-gray-200 text-gray-700 py-4 rounded-2xl font-semibold transition-all"
        >
          Cancel
        </a>

        <%= f.submit "Save Pet",
          class: "flex-1 bg-blue-700 hover:bg-blue-800 text-white py-4 rounded-2xl font-semibold shadow-lg transition-all duration-200 cursor-pointer text-lg" %>

      </div>

    <% end %>

  </div>

</div>