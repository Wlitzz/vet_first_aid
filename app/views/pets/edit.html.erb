<div class="max-w-5xl mx-auto">

  <div class="bg-white rounded-3xl shadow-xl border border-blue-100 p-10">

    <h1 class="text-4xl font-bold text-gray-900 mb-2">
      Edit Pet
    </h1>

    <p class="text-gray-500 mb-8">
      Update your pet information.
    </p>

    <% if @pet.errors.any? %>
      <div class="mb-6 bg-red-100 border border-red-300 text-red-700 px-4 py-3 rounded-2xl">
        <ul class="list-disc ml-5">
          <% @pet.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: @pet,
      url: "/pets/#{@pet.id}",
      method: :patch,
      local: true,
      class: "space-y-8" do |f| %>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

        <div>
          <%= f.label :name,
            class: "block text-sm font-semibold text-gray-700 mb-3" %>

          <%= f.text_field :name,
            class: "w-full px-5 py-4 rounded-2xl border border-gray-300" %>
        </div>

        <div>
          <%= f.label :species,
            class: "block text-sm font-semibold text-gray-700 mb-3" %>

          <%= f.select :species,
            ["Dog", "Cat", "Bird", "Rabbit", "Other"],
            {},
            class: "w-full px-5 py-4 rounded-2xl border border-gray-300" %>
        </div>

      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

        <div>
          <%= f.label :breed,
            class: "block text-sm font-semibold text-gray-700 mb-3" %>

          <%= f.text_field :breed,
            class: "w-full px-5 py-4 rounded-2xl border border-gray-300" %>
        </div>

        <div>
          <%= f.label :date_of_birth,
            class: "block text-sm font-semibold text-gray-700 mb-3" %>

          <%= f.date_field :date_of_birth,
            class: "w-full px-5 py-4 rounded-2xl border border-gray-300" %>
        </div>

      </div>

      <div>
        <%= f.label :weight,
          class: "block text-sm font-semibold text-gray-700 mb-3" %>

        <%= f.number_field :weight,
          step: 0.1,
          class: "w-full px-5 py-4 rounded-2xl border border-gray-300" %>
      </div>

      <div>
        <%= f.label :allergies,
          class: "block text-sm font-semibold text-gray-700 mb-3" %>

        <%= f.text_field :allergies,
          class: "w-full px-5 py-4 rounded-2xl border border-gray-300" %>
      </div>

      <div>
        <%= f.label :medical_notes,
          class: "block text-sm font-semibold text-gray-700 mb-3" %>

        <%= f.text_area :medical_notes,
          rows: 5,
          class: "w-full px-5 py-4 rounded-2xl border border-gray-300" %>
      </div>

      <%= f.submit "Save Changes",
        class: "w-full bg-blue-700 hover:bg-blue-800 text-white py-4 rounded-2xl font-semibold cursor-pointer" %>

    <% end %>

  </div>

</div>