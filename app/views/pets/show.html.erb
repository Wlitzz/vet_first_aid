<div class="max-w-5xl mx-auto space-y-8">

  <div class="bg-white rounded-3xl shadow-xl border border-blue-100 p-8">

    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-5">

      <div>

        <h1 class="text-4xl font-bold text-gray-900">
          <%= @pet.name %>
        </h1>

        <p class="text-gray-500 mt-2">
          <%= @pet.species %>

          <% if @pet.breed.present? %>
            • <%= @pet.breed %>
          <% end %>
        </p>

      </div>

      <div class="flex gap-4">

        <a href="/pets/<%= @pet.id %>/edit"
           class="bg-blue-700 hover:bg-blue-800 text-white px-5 py-3 rounded-xl font-semibold transition-all">
          Edit Pet
        </a>

        <button
          onclick="document.getElementById('delete-modal').classList.remove('hidden')"
          class="bg-red-600 hover:bg-red-700 text-white px-5 py-3 rounded-xl font-semibold transition-all"
        >
          Delete Pet
        </button>

      </div>

    </div>

  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

    <div class="bg-white rounded-3xl shadow-xl border border-blue-100 p-8">

      <h2 class="text-2xl font-bold text-gray-900 mb-6">
        Pet Information
      </h2>

      <div class="space-y-4 text-gray-700">

        <p>
          <strong>Species:</strong>
          <%= @pet.species %>
        </p>

        <p>
          <strong>Breed:</strong>
          <%= @pet.breed.presence || "Not provided" %>
        </p>

        <p>
          <strong>Date of Birth:</strong>
          <%= @pet.date_of_birth.present? ? @pet.date_of_birth.strftime("%d %B %Y") : "Not provided" %>
        </p>

        <p>
          <strong>Weight:</strong>
          <%= @pet.weight.present? ? "#{@pet.weight} kg" : "Not provided" %>
        </p>

      </div>

    </div>

    <div class="bg-white rounded-3xl shadow-xl border border-blue-100 p-8">

      <h2 class="text-2xl font-bold text-gray-900 mb-6">
        Medical Information
      </h2>

      <div class="space-y-4 text-gray-700">

        <p>
          <strong>Allergies:</strong>
          <%= @pet.allergies.presence || "None" %>
        </p>

        <p>
          <strong>Medical Notes:</strong>
        </p>

        <div class="bg-gray-50 border border-gray-200 rounded-2xl p-4 text-gray-600 leading-relaxed">
          <%= @pet.medical_notes.presence || "No medical notes added yet." %>
        </div>

      </div>

    </div>

  </div>

  <div class="flex justify-end">

    <a href="/profile"
       class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-6 py-3 rounded-xl font-semibold transition-all">
      Back to Profile
    </a>

  </div>

</div>

<div
  id="delete-modal"
  class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50"
>

  <div class="bg-white rounded-3xl shadow-2xl p-8 max-w-md w-full mx-4">

    <h2 class="text-2xl font-bold text-gray-900 mb-3">
      Delete Pet
    </h2>

    <p class="text-gray-600 mb-8 leading-relaxed">
      Are you sure you want to delete this pet profile?
      This action cannot be undone.
    </p>

    <div class="flex justify-end gap-4">

      <button
        onclick="document.getElementById('delete-modal').classList.add('hidden')"
        class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-5 py-3 rounded-xl font-semibold transition-all"
      >
        Cancel
      </button>

      <%= button_to "Delete",
        "/pets/#{@pet.id}",
        method: :delete,
        class: "bg-red-600 hover:bg-red-700 text-white px-5 py-3 rounded-xl font-semibold transition-all cursor-pointer" %>

    </div>

  </div>

</div>