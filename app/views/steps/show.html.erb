<% content_for :title, "Step #{@step.position} – #{@procedure.name}" %>

<div class="max-w-2xl mx-auto">
  <%# Breadcrumb %>
  <nav class="text-sm text-gray-500 mb-6">
    <%= link_to "Triage", triage_path, class: "hover:text-blue-600" %>
    <span class="mx-2">›</span>
    <%= link_to @procedure.name, first_aid_procedure_path(@procedure), class: "hover:text-blue-600" %>
    <span class="mx-2">›</span>
    <span class="text-gray-800 font-medium">Step <%= @step.position %></span>
  </nav>

  <%# Step header %>
  <div class="flex items-center gap-3 mb-6">
    <span class="w-10 h-10 rounded-full bg-blue-600 text-white flex items-center justify-center text-lg font-bold shrink-0">
      <%= @step.position %>
    </span>
    <p class="text-sm text-gray-500">Step <%= @step.position %> of <%= @total %></p>
  </div>

  <%# Instruction %>
  <div class="bg-white border border-gray-200 rounded-xl p-6 mb-6 shadow-sm">
    <p class="text-xl font-semibold text-gray-900 leading-relaxed"><%= @step.instruction %></p>
  </div>

  <%# Embedded video (step-level) %>
  <% if @video %>
    <div class="mb-6">
      <p class="text-sm font-semibold text-gray-700 mb-2"><%= @video.title %></p>
      <% if @video.embed_url %>
        <div class="aspect-video rounded-lg overflow-hidden bg-black">
          <iframe src="<%= @video.embed_url %>" class="w-full h-full" allowfullscreen
            title="<%= @video.title %>"></iframe>
        </div>
      <% else %>
        <%= link_to "▶ Watch: #{@video.title}", @video.url, target: "_blank",
          class: "text-blue-600 hover:text-blue-800 underline text-sm" %>
      <% end %>
    </div>
  <% end %>

  <%# Checklist %>
  <% if @step.checklist_items.any? %>
    <div class="bg-green-50 border border-green-200 rounded-xl p-5 mb-6">
      <h3 class="text-sm font-bold text-green-800 uppercase tracking-wide mb-3">What to look for</h3>
      <ul class="space-y-2">
        <% @step.checklist_items.each do |item| %>
          <li class="flex items-start gap-2 text-sm text-green-900">
            <span class="shrink-0 mt-0.5 text-green-600">✓</span>
            <%= item %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# Navigation %>
  <div class="flex justify-between items-center mt-8">
    <% if @prev_step %>
      <%= link_to "← Back",
        first_aid_procedure_step_path(@procedure, @prev_step),
        class: "border border-gray-300 text-gray-700 hover:bg-gray-100 font-semibold py-3 px-6 rounded-lg transition-colors" %>
    <% else %>
      <%= link_to "← Back to Guide",
        first_aid_procedure_path(@procedure),
        class: "border border-gray-300 text-gray-700 hover:bg-gray-100 font-semibold py-3 px-6 rounded-lg transition-colors" %>
    <% end %>

    <% if @next_step %>
      <%= link_to "Next →",
        first_aid_procedure_step_path(@procedure, @next_step),
        class: "bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-8 rounded-lg transition-colors" %>
    <% else %>
      <%= link_to "Finish - Return to Guide",
        first_aid_procedure_path(@procedure),
        class: "bg-green-600 hover:bg-green-700 text-white font-bold py-3 px-8 rounded-lg transition-colors" %>
    <% end %>
  </div>
</div>
