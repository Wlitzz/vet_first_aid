<% content_for :title, "Find a Vet Clinic – Vet First Aid" %>

<div class="max-w-3xl mx-auto">
  <h1 class="text-3xl font-extrabold text-gray-900 mb-2">Find a Nearby Vet Clinic</h1>
  <p class="text-gray-500 mb-8">Search by location &middot; Filter by availability &middot; Navigate instantly</p>

  <%= form_with url: clinics_path, method: :get,
        data: { turbo: false },
        id: "clinic-search-form" do |f| %>

    <%= hidden_field_tag :lat, @lat %>
    <%= hidden_field_tag :lng, @lng %>

    <div class="mb-6">
      <p class="text-sm font-semibold text-gray-700 uppercase tracking-wide mb-3">1. Select species</p>
      <div class="flex flex-wrap gap-3 items-center">
        <%= select_tag :species,
              options_for_select([["All species", ""]] + @species_list.map { |s| [s, s] }, params[:species]),
              class: "border border-gray-300 rounded-lg px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>

        <label class="flex items-center gap-2 text-sm text-gray-700 cursor-pointer">
          <%= check_box_tag :open_now, "1", params[:open_now] == "1",
                class: "w-4 h-4 accent-blue-600" %>
          Open now
        </label>

        <label class="flex items-center gap-2 text-sm text-gray-700 cursor-pointer">
          <%= check_box_tag :emergency_24_7, "1", params[:emergency_24_7] == "1",
                class: "w-4 h-4 accent-blue-600" %>
          24/7 Emergency
        </label>
      </div>
    </div>

    <div class="mb-6">
      <p class="text-sm font-semibold text-gray-700 uppercase tracking-wide mb-3">2. Set your location</p>
      <div class="flex gap-2">
        <button type="submit"
                class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-3 rounded-lg text-sm cursor-pointer transition-colors">
          Search
        </button>
        <button type="button"
                id="locate-btn"
                class="bg-gray-800 hover:bg-gray-900 text-white font-semibold px-6 py-3 rounded-lg text-sm cursor-pointer transition-colors">
          &#9678; Use My Location
        </button>
      </div>
    </div>

  <% end %>

  <%# Flash messages %>
  <% if flash[:alert].present? %>
    <div class="bg-yellow-50 border-l-4 border-yellow-400 text-yellow-700 px-4 py-3 rounded mb-4 text-sm">
      <%= flash[:alert] %>
    </div>
  <% end %>

  <%# Results %>
  <div class="mt-2">
    <% if @clinics.present? %>
      <p class="text-sm text-gray-500 mb-4">
        Showing <strong class="text-gray-900"><%= @clinics.size %></strong>
        clinic<%= @clinics.size == 1 ? "" : "s" %>
        <% if @radius_km %>within <strong class="text-gray-900"><%= @radius_km %> km</strong><% end %>
        <% if @lat && @lng %>of your location<% end %>
      </p>
      <div class="space-y-4">
        <% @clinics.each do |clinic| %>
          <%= render partial: "clinic_card", locals: { clinic: clinic, lat: @lat, lng: @lng } %>
        <% end %>
      </div>

    <% elsif @clinics&.empty? %>
      <div class="text-center py-12 text-gray-500">
        <p class="text-lg font-medium">No clinics found.</p>
        <p class="text-sm mt-1">We searched up to 100 km but found nothing matching your filters. Try removing a filter or checking back later.</p>

        <% if @show_helpline %>
          <div class="mt-6 bg-red-50 border border-red-200 rounded-xl p-6 text-center">
            <p class="font-bold text-red-700 text-base mb-1">&#128222; Emergency Veterinary Hotline</p>
            <p class="text-sm text-gray-500 mb-2">Contact the Veterinary Association directly for urgent help.</p>
            <a href="tel:+60123456789" class="text-2xl font-bold text-gray-900 hover:text-red-600 transition-colors font-mono">
              +60 12-345 6789
            </a>
          </div>
        <% end %>
      </div>

    <% else %>
      <div class="text-center py-12 text-gray-500">
        <p class="text-4xl mb-3">&#128205;</p>
        <p class="text-lg font-medium text-gray-900">Allow location to get started</p>
        <p class="text-sm mt-1">Click <strong>Use My Location</strong> or tap <strong>Search</strong> after entering your coordinates above.</p>
      </div>
    <% end %>
  </div>
</div>

<script>
  (function () {
    const locateBtn = document.getElementById('locate-btn');
    const latInput  = document.querySelector('input[name="lat"]');
    const lngInput  = document.querySelector('input[name="lng"]');
    const form      = document.getElementById('clinic-search-form');

    if (!locateBtn) return;

    locateBtn.addEventListener('click', function () {
      if (!navigator.geolocation) {
        alert('Geolocation is not supported by your browser.');
        return;
      }
      locateBtn.textContent = 'Locating…';
      locateBtn.disabled = true;

      navigator.geolocation.getCurrentPosition(
        function (pos) {
          latInput.value = pos.coords.latitude.toFixed(6);
          lngInput.value = pos.coords.longitude.toFixed(6);
          form.submit();
        },
        function (err) {
          locateBtn.textContent = '⊕ Use My Location';
          locateBtn.disabled = false;
          alert('Could not get your location. Please check browser permissions.');
        },
        { enableHighAccuracy: true, timeout: 8000 }
      );
    });
  })();
</script>
