<% content_for :title, "#{@clinic.name} – Vet First Aid" %>

<div class="max-w-3xl mx-auto">

  <%# Back link %>
  <div class="mb-4">
    <%= link_to clinics_path(
          lat: params[:lat], lng: params[:lng],
          species: params[:species],
          open_now: params[:open_now],
          emergency_24_7: params[:emergency_24_7]),
          class: "text-sm text-gray-500 hover:text-blue-600 transition-colors inline-flex items-center gap-1" do %>
      &larr; Back to results
    <% end %>
  </div>

  <%# Hero header %>
  <div class="<%= @clinic.emergency_24_7 ? 'bg-red-700' : 'bg-gray-900' %> text-white rounded-xl px-6 py-6 mb-6">
    <div class="flex flex-wrap gap-2 mb-3">
      <% if @clinic.emergency_24_7 %>
        <span class="px-3 py-1 rounded-full bg-red-100 text-red-700 text-xs font-bold uppercase tracking-wide">&#9888; 24/7 Emergency</span>
      <% end %>
      <% if @clinic.open_now? %>
        <span class="px-3 py-1 rounded-full bg-green-100 text-green-700 text-xs font-bold uppercase tracking-wide">&#9679; Open Now</span>
      <% else %>
        <span class="px-3 py-1 rounded-full bg-gray-100 text-gray-600 text-xs font-bold uppercase tracking-wide">&#9679; Closed</span>
      <% end %>
      <% if @clinic.stale? %>
        <span class="px-3 py-1 rounded-full bg-yellow-100 text-yellow-700 text-xs font-bold uppercase tracking-wide">&#9888; Info may be outdated</span>
      <% end %>
    </div>
    <h1 class="text-2xl font-extrabold mb-1"><%= @clinic.name %></h1>
    <p class="text-white/70 text-sm">&#128205; <%= @clinic.address %></p>
  </div>

  <%# Body grid %>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">

    <%# Left: contact + species + freshness %>
    <div class="bg-white border border-gray-200 rounded-xl p-5 shadow-sm">

      <h3 class="text-xs font-bold uppercase tracking-widest text-gray-400 border-b border-gray-100 pb-2 mb-4">Contact</h3>

      <% if @clinic.phone.present? %>
        <p class="text-sm mb-2">
          &#128222;
          <%= link_to @clinic.phone, "tel:#{@clinic.phone}",
                class: "font-bold text-green-700 hover:underline text-base" %>
        </p>
      <% end %>
      <% if @clinic.email.present? %>
        <p class="text-sm text-gray-700 mb-2">
          &#9993; <%= link_to @clinic.email, "mailto:#{@clinic.email}", class: "hover:text-blue-600 hover:underline" %>
        </p>
      <% end %>
      <% if @clinic.website.present? %>
        <p class="text-sm text-gray-700 mb-2">
          &#127760; <%= link_to @clinic.website, @clinic.website, target: "_blank", rel: "noopener noreferrer", class: "hover:text-blue-600 hover:underline break-all" %>
        </p>
      <% end %>

      <% if @clinic.species_accepted.any? %>
        <h3 class="text-xs font-bold uppercase tracking-widest text-gray-400 border-b border-gray-100 pb-2 mb-3 mt-5">Accepts</h3>
        <div class="flex flex-wrap gap-2">
          <% @clinic.species_accepted.each do |sp| %>
            <span class="px-3 py-1 rounded-full bg-blue-50 text-blue-700 text-sm font-semibold capitalize"><%= sp %></span>
          <% end %>
        </div>
      <% end %>

      <h3 class="text-xs font-bold uppercase tracking-widest text-gray-400 border-b border-gray-100 pb-2 mb-3 mt-5">Data Freshness</h3>
      <p class="text-sm text-gray-500">
        Last verified: <strong class="text-gray-700"><%= @clinic.last_verified_at&.strftime("%d %b %Y") || "Unknown" %></strong>
        <% if @clinic.stale? %>
          <span class="text-yellow-600 italic"> — data may be outdated</span>
        <% end %>
      </p>

    </div>

    <%# Right: hours + CTA %>
    <div class="bg-white border border-gray-200 rounded-xl p-5 shadow-sm">

      <h3 class="text-xs font-bold uppercase tracking-widest text-gray-400 border-b border-gray-100 pb-2 mb-4">Opening Hours</h3>

      <% if @clinic.emergency_24_7 %>
        <p class="text-green-700 font-semibold text-sm">This clinic operates 24 hours, 7 days a week.</p>
      <% else %>
        <table class="w-full text-sm">
          <tbody>
            <% %w[Mon Tue Wed Thu Fri Sat Sun].each do |day| %>
              <%
                hours    = @clinic.opening_hours[day] || "Closed"
                is_today = VeterinaryClinic::DAY_ABBREVIATIONS[Date.today.wday] == day
              %>
              <tr class="<%= 'bg-blue-50' if is_today %> border-b border-gray-100 last:border-0">
                <td class="py-2 pr-4 <%= is_today ? 'text-blue-700 font-bold' : 'text-gray-500 font-medium' %> w-2/5">
                  <%= day %><%= " (today)" if is_today %>
                </td>
                <td class="py-2 <%= hours.downcase == 'closed' ? 'text-gray-400' : 'font-semibold text-gray-800' %>">
                  <%= hours %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>

      <%# CTA buttons %>
      <div class="flex gap-3 mt-6 flex-wrap">
        <% if @clinic.phone.present? %>
          <%= link_to "tel:#{@clinic.phone}",
                class: "flex-1 inline-flex items-center justify-center gap-2 px-4 py-3 rounded-lg bg-red-600 hover:bg-red-700 text-white font-bold text-sm transition-colors" do %>
            &#128222; Call Now
          <% end %>
        <% end %>

        <%= link_to "https://maps.google.com/?q=#{CGI.escape(@clinic.address)}",
              target: "_blank", rel: "noopener noreferrer",
              class: "flex-1 inline-flex items-center justify-center gap-2 px-4 py-3 rounded-lg bg-gray-900 hover:bg-gray-700 text-white font-bold text-sm transition-colors" do %>
          &#128506; Open in Maps
        <% end %>
      </div>

    </div>

  </div>
</div>
