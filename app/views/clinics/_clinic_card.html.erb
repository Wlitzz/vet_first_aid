<%# =============================================================================
  # _clinic_card.html.erb
  # SWE30003 – Group 17 | Clinic Locator Lead
  #
  # Partial rendered for each VeterinaryClinic in the search results list.
  # Locals expected:
  #   clinic  – VeterinaryClinic instance
  #   lat     – Float, user latitude  (may be nil)
  #   lng     – Float, user longitude (may be nil)
  # =============================================================================
  %>

<%
  distance_km  = (lat && lng) ? clinic.distance_to(lat, lng).round(1) : nil
  is_open      = clinic.open_now?
  is_emergency = clinic.emergency_24_7
  is_stale     = clinic.stale?
  today_hours  = clinic.todays_hours
%>

<article class="clinic-card <%= 'clinic-card--emergency' if is_emergency %> <%= 'clinic-card--closed' unless is_open %>"
         data-clinic-id="<%= clinic.id %>"
         data-lat="<%= clinic.latitude %>"
         data-lng="<%= clinic.longitude %>">

  <%# ── Status ribbon ─────────────────────────────────────────────────── %>
  <div class="clinic-card__ribbon">
    <% if is_emergency %>
      <span class="badge badge--emergency">
        <svg class="badge__icon" viewBox="0 0 16 16" aria-hidden="true">
          <path d="M8 1a7 7 0 1 0 0 14A7 7 0 0 0 8 1Zm.75 3.5v4a.75.75 0 0 1-1.5 0v-4a.75.75 0 0 1 1.5 0Zm-.75 6.5a.875.875 0 1 1 0-1.75.875.875 0 0 1 0 1.75Z"/>
        </svg>
        24 / 7 Emergency
      </span>
    <% end %>

    <span class="badge <%= is_open ? 'badge--open' : 'badge--closed' %>">
      <span class="badge__dot"></span>
      <%= is_open ? "Open Now" : "Closed" %>
    </span>

    <% if is_stale %>
      <span class="badge badge--stale" title="Last verified more than 90 days ago">
        &#9888; Unverified
      </span>
    <% end %>
  </div>

  <%# ── Main body ─────────────────────────────────────────────────────── %>
  <div class="clinic-card__body">
    <div class="clinic-card__info">

      <h2 class="clinic-card__name">
        <%= link_to clinic.name, clinic_path(clinic,
              lat: lat, lng: lng,
              species: params[:species],
              open_now: params[:open_now],
              emergency_24_7: params[:emergency_24_7]),
              class: "clinic-card__name-link" %>
      </h2>

      <p class="clinic-card__address">
        <svg class="inline-icon" viewBox="0 0 16 16" aria-hidden="true">
          <path d="M8 1a5 5 0 0 0-5 5c0 3.4 4.4 8.4 4.6 8.6a.5.5 0 0 0 .8 0C8.6 14.4 13 9.4 13 6a5 5 0 0 0-5-5Zm0 7a2 2 0 1 1 0-4 2 2 0 0 1 0 4Z"/>
        </svg>
        <%= clinic.address %>
      </p>

      <p class="clinic-card__hours">
        <svg class="inline-icon" viewBox="0 0 16 16" aria-hidden="true">
          <path d="M8 1a7 7 0 1 0 0 14A7 7 0 0 0 8 1Zm.5 7.207V4.5a.5.5 0 0 0-1 0v4a.5.5 0 0 0 .146.354l2 2a.5.5 0 0 0 .708-.708L8.5 8.207Z"/>
        </svg>
        Today: <strong><%= today_hours %></strong>
      </p>

      <% if clinic.species_accepted.any? %>
        <div class="clinic-card__species">
          <% clinic.species_accepted.each do |sp| %>
            <span class="species-tag"><%= sp %></span>
          <% end %>
        </div>
      <% end %>

    </div>

    <%# ── Right column: distance + actions ─────────────────────────────── %>
    <div class="clinic-card__meta">
      <% if distance_km %>
        <div class="clinic-card__distance">
          <span class="distance__value"><%= distance_km %></span>
          <span class="distance__unit">km</span>
        </div>
      <% end %>

      <div class="clinic-card__actions">
        <% if clinic.phone.present? %>
          <%= link_to "tel:#{clinic.phone}", class: "btn btn--icon btn--call", title: "Call #{clinic.phone}" do %>
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path d="M3.654 1.328a.678.678 0 0 0-1.015-.063L1.605 2.3c-.483.484-.661 1.169-.45 1.77a17.6 17.6 0 0 0 4.168 6.608 17.6 17.6 0 0 0 6.608 4.168c.601.211 1.286.033 1.77-.45l1.034-1.034a.678.678 0 0 0-.063-1.015l-2.307-1.794a.678.678 0 0 0-.58-.122L9.82 10.84a1.49 1.49 0 0 1-1.354-.36l-3.062-3.063a1.49 1.49 0 0 1-.36-1.354l.651-2.965a.678.678 0 0 0-.122-.58L3.654 1.328Z"/>
            </svg>
            <span>Call</span>
          <% end %>
        <% end %>

        <%= link_to "https://maps.google.com/?q=#{CGI.escape(clinic.address)}",
              target: "_blank", rel: "noopener noreferrer",
              class: "btn btn--icon btn--navigate", title: "Open in maps" do %>
          <svg viewBox="0 0 16 16" aria-hidden="true">
            <path d="M8 1a5 5 0 0 0-5 5c0 3.4 4.4 8.4 4.6 8.6a.5.5 0 0 0 .8 0C8.6 14.4 13 9.4 13 6a5 5 0 0 0-5-5Zm0 7a2 2 0 1 1 0-4 2 2 0 0 1 0 4Z"/>
          </svg>
          <span>Navigate</span>
        <% end %>

        <%= link_to clinic_path(clinic,
              lat: lat, lng: lng,
              species: params[:species],
              open_now: params[:open_now],
              emergency_24_7: params[:emergency_24_7]),
              class: "btn btn--details" do %>
          Details
          <svg viewBox="0 0 16 16" aria-hidden="true">
            <path fill-rule="evenodd" d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708Z"/>
          </svg>
        <% end %>
      </div>
    </div>
  </div>

</article>
