<%
  distance_km  = (lat && lng) ? clinic.distance_to(lat, lng).round(1) : nil
  is_open      = clinic.open_now?
  is_emergency = clinic.emergency_24_7
  is_stale     = clinic.stale?
  today_hours  = clinic.todays_hours
%>

<div class="bg-white border <%= is_emergency ? 'border-l-4 border-l-red-500 border-gray-200' : 'border-gray-200' %> rounded-xl shadow-sm hover:shadow-md transition-shadow <%= 'opacity-80' unless is_open %>">

  <%# Status ribbon %>
  <div class="flex flex-wrap gap-2 px-4 pt-3 pb-2 bg-gray-50 border-b border-gray-100 rounded-t-xl">
    <% if is_emergency %>
      <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-bold uppercase tracking-wide bg-red-100 text-red-700">
        &#9888; 24/7 Emergency
      </span>
    <% end %>

    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-bold uppercase tracking-wide <%= is_open ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-500' %>">
      <span class="w-2 h-2 rounded-full bg-current <%= is_open ? 'animate-pulse' : '' %>"></span>
      <%= is_open ? "Open Now" : "Closed" %>
    </span>

    <% if is_stale %>
      <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-bold uppercase tracking-wide bg-yellow-100 text-yellow-700">
        &#9888; Unverified
      </span>
    <% end %>
  </div>

  <%# Main body %>
  <div class="flex justify-between items-start gap-4 px-4 py-4">
    <div class="flex-1 min-w-0">

      <h2 class="text-lg font-bold text-gray-900 mb-1">
        <%= link_to clinic.name, clinic_path(clinic,
              lat: lat, lng: lng,
              species: params[:species],
              open_now: params[:open_now],
              emergency_24_7: params[:emergency_24_7]),
              class: "hover:text-blue-600 transition-colors" %>
      </h2>

      <p class="text-sm text-gray-500 mb-1">&#128205; <%= clinic.address %></p>
      <p class="text-sm text-gray-500 mb-2">&#128336; Today: <strong class="text-gray-700"><%= today_hours %></strong></p>

      <% if clinic.species_accepted.any? %>
        <div class="flex flex-wrap gap-1">
          <% clinic.species_accepted.each do |sp| %>
            <span class="px-2 py-0.5 rounded-full bg-blue-50 text-blue-700 text-xs font-semibold capitalize"><%= sp %></span>
          <% end %>
        </div>
      <% end %>

    </div>

    <%# Right: distance + actions %>
    <div class="flex flex-col items-end gap-3 flex-shrink-0">
      <% if distance_km %>
        <div class="text-right leading-tight">
          <span class="block text-2xl font-bold text-blue-600"><%= distance_km %></span>
          <span class="text-xs text-gray-400 uppercase tracking-wide">km</span>
        </div>
      <% end %>

      <div class="flex gap-1 items-center">
        <% if clinic.phone.present? %>
          <%= link_to "tel:#{clinic.phone}",
                class: "inline-flex items-center gap-1 px-3 py-1.5 rounded-lg bg-green-50 text-green-700 border border-green-200 text-xs font-semibold hover:bg-green-100 transition-colors" do %>
            &#128222; Call
          <% end %>
        <% end %>

        <%= link_to "https://maps.google.com/?q=#{CGI.escape(clinic.address)}",
              target: "_blank", rel: "noopener noreferrer",
              class: "inline-flex items-center gap-1 px-3 py-1.5 rounded-lg bg-blue-50 text-blue-700 border border-blue-200 text-xs font-semibold hover:bg-blue-100 transition-colors" do %>
          &#128506; Navigate
        <% end %>

        <%= link_to clinic_path(clinic,
              lat: lat, lng: lng,
              species: params[:species],
              open_now: params[:open_now],
              emergency_24_7: params[:emergency_24_7]),
              class: "inline-flex items-center gap-1 px-3 py-1.5 rounded-lg border border-gray-200 text-gray-500 text-xs font-semibold hover:text-gray-900 hover:border-gray-400 transition-colors" do %>
          Details &rarr;
        <% end %>
      </div>
    </div>
  </div>

</div>
