<% content_for :title, "#{@quiz.title} — Training Quiz" %>

<div data-controller="quiz-timer quiz-progress"
     data-quiz-timer-seconds-value="120"
     data-quiz-progress-total-value="<%= @quiz.quiz_questions.length %>">

  <%# Sticky progress + timer bar %>
  <div class="sticky top-0 z-40 bg-white/95 backdrop-blur border-b border-gray-200 shadow-sm -mx-4 sm:-mx-6 lg:-mx-8 px-4 sm:px-6 lg:px-8 py-3 mb-6">
    <div class="max-w-2xl mx-auto flex items-center gap-4">
      <div class="flex-1">
        <div class="flex justify-between text-xs text-gray-500 mb-1.5">
          <span data-quiz-progress-target="count">0 of <%= @quiz.quiz_questions.length %> answered</span>
          <span class="font-medium text-blue-700"><%= @quiz.title %></span>
        </div>
        <div class="h-2 bg-gray-100 rounded-full overflow-hidden">
          <div data-quiz-progress-target="bar"
               class="h-full bg-blue-600 rounded-full transition-[width] duration-300 ease-out"
               style="width: 0%"></div>
        </div>
      </div>
      <div class="flex-shrink-0 flex items-center gap-1.5 bg-gray-100 rounded-lg px-3 py-1.5">
        <span class="text-base">⏱</span>
        <span data-quiz-timer-target="display" class="font-mono font-bold text-gray-700 text-sm tabular-nums">2:00</span>
      </div>
    </div>
  </div>

  <div class="max-w-2xl mx-auto pb-8">
    <div class="mb-8">
      <%= link_to "← Back to Topics", quiz_path, class: "text-blue-700 hover:text-blue-600 text-sm font-medium" %>
      <div class="mt-4 flex items-center gap-3">
        <span class="text-4xl"><%= @quiz.icon %></span>
        <div>
          <h1 class="text-2xl font-bold text-gray-900"><%= @quiz.title %></h1>
          <p class="text-sm text-gray-500">Answer all questions then submit — you have 2 minutes</p>
        </div>
      </div>
    </div>

    <%= form_with url: quiz_result_path(topic: @quiz.topic_key), method: :post, class: "space-y-4", data: { turbo: false } do |f| %>
      <% @quiz.quiz_questions.each_with_index do |q, i| %>
        <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6 hover:border-blue-200 transition-colors">
          <div class="flex gap-3 mb-5">
            <span class="flex-shrink-0 w-8 h-8 rounded-full bg-blue-600 text-white flex items-center justify-center text-sm font-bold"><%= i + 1 %></span>
            <p class="font-semibold text-gray-900 pt-1 leading-snug"><%= q.prompt %></p>
          </div>

          <div class="space-y-2">
            <% q.options.each do |option| %>
              <label class="flex items-center gap-3 p-3 rounded-xl border border-gray-200 hover:border-blue-400 hover:bg-blue-50/60 cursor-pointer transition-all has-[:checked]:border-blue-500 has-[:checked]:bg-blue-50 has-[:checked]:shadow-sm">
                <input type="radio" name="answers[<%= i %>]" value="<%= option %>"
                       class="w-4 h-4 text-blue-700 border-gray-300 focus:ring-blue-500"
                       data-action="change->quiz-progress#answer">
                <span class="text-gray-800 text-sm"><%= option %></span>
              </label>
            <% end %>
          </div>
        </div>
      <% end %>

      <div class="pt-4 pb-2">
        <button type="submit"
                class="w-full bg-blue-700 hover:bg-blue-600 active:bg-blue-800 text-white py-4 px-6 rounded-2xl font-bold text-base transition-colors shadow-sm">
          Submit Quiz ✓
        </button>
      </div>
    <% end %>
  </div>
</div>
