<% content_for :title, "#{@quiz.title} — Training Quiz" %>

<div class="py-6 max-w-2xl mx-auto">
  <div class="mb-6">
    <%= link_to "← Back to Topics", quiz_path, class: "text-blue-700 hover:text-blue-600 text-sm font-medium" %>
    <div class="mt-3 flex items-center gap-3">
      <span class="text-3xl"><%= @quiz.icon %></span>
      <div>
        <h1 class="text-2xl font-bold text-gray-900"><%= @quiz.title %></h1>
        <p class="text-sm text-gray-500"><%= @quiz.questions.length %> questions — answer all before submitting</p>
      </div>
    </div>
  </div>

  <%= form_with url: quiz_result_path(topic: @quiz.topic_key), method: :post, class: "space-y-5", data: { turbo: false } do |f| %>
    <% @quiz.questions.each_with_index do |q, i| %>
      <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
        <p class="font-semibold text-gray-900 mb-4">
          <span class="text-blue-700 font-bold"><%= i + 1 %>.</span>
          <%= q[:text] %>
        </p>

        <% options = q[:type] == :true_false ? [ "true", "false" ] : q[:options] %>
        <div class="space-y-2">
          <% options.each do |option| %>
            <label class="flex items-center gap-3 p-3 rounded-lg border border-gray-100 hover:border-blue-300 hover:bg-blue-50 cursor-pointer transition-colors has-[:checked]:border-blue-500 has-[:checked]:bg-blue-50">
              <input type="radio" name="answers[<%= i %>]" value="<%= option %>" <%= "required" if option == options.first %>
                     class="w-4 h-4 text-blue-700 border-gray-300 focus:ring-blue-500">
              <span class="text-gray-800 text-sm capitalize">
                <%= option == "true" ? "True" : option == "false" ? "False" : option %>
              </span>
            </label>
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="pt-2 pb-6">
      <button type="submit"
              class="w-full bg-blue-700 hover:bg-blue-600 active:bg-blue-800 text-white py-3 px-6 rounded-xl font-semibold text-base transition-colors shadow-sm">
        Submit Quiz
      </button>
    </div>
  <% end %>
</div>
